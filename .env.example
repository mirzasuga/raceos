# ============================================================
# RaceOS AI Software Factory — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ============================================================

# --- REQUIRED ---

# OpenRouter API key (get one at https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxx

# GitHub Personal Access Token (for PR creation)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# --- OPTIONAL OVERRIDES ---

# Override default models (see config/models.yaml for catalog)
# ROUTER_MODEL=meta-llama/llama-4-scout
# AGENT_MODEL=anthropic/claude-sonnet-4.6

# Budget limits (USD)
# DAILY_BUDGET_USD=50.00
# PER_TASK_BUDGET_USD=5.00

# Brain path (if not at default relative location)
# BRAIN_ROOT=../.raceos/

# Logging
# LOG_LEVEL=INFO
# LOG_FORMAT=json

# OpenCode binary path (if not in PATH)
# OPENCODE_BIN=opencode
