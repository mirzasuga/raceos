# ============================================================
# RaceOS AI Software Factory — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ============================================================

# --- LLM GATEWAY (required — choose one) ---

# Option A: 9Router (local/hosted)
NINE_ROUTER_API_KEY=your-9router-api-key-here

# Option B: OpenRouter (alternative)
# OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxx

# --- OPTIONAL ---

# GitHub token (for PR creation)
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Budget overrides
# DAILY_BUDGET_USD=50.00
# PER_TASK_BUDGET_USD=5.00

# Logging
# LOG_LEVEL=INFO
# LOG_FORMAT=json
